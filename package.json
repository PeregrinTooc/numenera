{
  "name": "numenera",
  "version": "0.2.0",
  "description": "Numenera Character Sheet - A responsive web application for managing Numenera P&P RPG characters",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan --host",
    "build": "tsc && vite build",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
    "kill": "pkill -9 -f vite || true",
    "test": "npm run test:unit && npm run test:e2e:all",
    "test:mutation": "stryker run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:e2e": "node scripts/e2e.js",
    "test:e2e:current": "node scripts/e2e.js \"tests/e2e/features/**/*.feature\" --tags @current",
    "test:e2e:all": "node scripts/e2e.js \"tests/e2e/features/**/*.feature\"",
    "test:e2e:prod": "npm run build && node scripts/e2e.js --prod \"tests/e2e/features/**/*.feature\"",
    "test:e2e:playwright": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "check:i18n": "node scripts/check-translation-coverage.js",
    "check:steps": "node scripts/step-catalog.js --check",
    "docs:steps": "node scripts/step-catalog.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=-1",
      "prettier --write"
    ],
    "*.{css,html,json,md}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeregrinTooc/numenera.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/PeregrinTooc/numenera/issues"
  },
  "homepage": "https://github.com/PeregrinTooc/numenera#readme",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^25.9.9",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitest/ui": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.8",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.33",
    "prettier": "~3.8.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.3.0",
    "lit-html": "^3.3.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
