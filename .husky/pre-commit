#!/bin/sh
echo "🔍 Running Pre-Commit Hook..."

# Run lint-staged (auto-fixes linting and formatting on staged files)
echo "📝 Running lint-staged (auto-format staged files)..."
npx lint-staged || exit 1

# Run unit tests to ensure no breaking changes
echo "🧪 Running unit tests..."
npm run test:unit || exit 1

# Check translation coverage (all t() keys exist in both locales)
echo "🌍 Checking translation coverage..."
npm run check:i18n || exit 1

# Check for unreachable Cucumber step definitions and a stale step catalog
echo "🪜 Checking Cucumber step definitions..."
npm run check:steps || exit 1

echo "✅ Pre-commit checks passed! Proceeding with commit..."
